# Paelon Memorial Hospital — environment variables
# Copy to .env.local and fill in. Never commit .env.local. Never log these values.
# Parsed and validated at boot by lib/env.ts — the app fails fast on a missing
# required var rather than erroring deep inside a request.

# --- Database (Neon) ---
# Required. DATABASE_URL is the pooled connection used by the app.
DATABASE_URL=
# Direct connection, used by drizzle-kit and `npm run db:migrate`. Migrations
# hold long-lived sessions and advisory locks, which a pooler handles badly.
DATABASE_URL_UNPOOLED=

# --- Operational ---
# Required. Salt for hashing IP addresses before they reach rate_limit_hits.
# An IP is personal data under NDPR, so the raw value is never stored.
# Generate with: openssl rand -base64 32
RATE_LIMIT_SALT=
# Shared secret for /api/jobs/* (retention, cleanup). Phase 2/3.
JOBS_SECRET=
# Version identifier for the privacy policy text shown alongside consent
# checkboxes. Recorded on every consenting row so we know which wording each
# person agreed to. Bump when the privacy policy copy changes.
CONSENT_TEXT_VERSION=2026-01-v1

# --- Auth (Phase 2 — not read by any Phase 1 code path) ---
AUTH_SECRET=
AUTH_URL=

# --- Uploads (UploadThing) ---
# Object storage for editorial images only — blog heroes, headshots, branch
# galleries. The site's own design assets stay in assets/ and /public.
# One token, from the UploadThing dashboard: API Keys -> V7. It replaces the v6
# UPLOADTHING_SECRET/UPLOADTHING_APP_ID pair, which no longer exist.
UPLOADTHING_TOKEN=
# Opens POST /api/uploadthing. Leave false everywhere except a local machine:
# Phase 1 has no auth, so an enabled endpoint is public file hosting on a
# hospital domain. Phase 2 replaces this with an Auth.js session check.
UPLOADTHING_UPLOADS_ENABLED=false

# --- Email (Resend, optional) ---
# The site must work end-to-end with RESEND_ENABLED=false: sends are skipped,
# logged, and reported as success. A disabled provider is not a failure.
# When true, RESEND_API_KEY and RESEND_FROM_EMAIL become required.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Booking notification inboxes, per branch ---
# Phase 1 fallback only. The authoritative value is locations.booking_email, so
# a branch added through the Phase 2 CMS does not need a redeploy. These are
# matched by location slug: victoria-island, ikeja, moshood, delta.
BRANCH_VI_EMAIL=
BRANCH_IKEJA_EMAIL=
BRANCH_MOSHOOD_EMAIL=
BRANCH_DELTA_EMAIL=

# --- WhatsApp Business (provider TBD) ---
# Empty means the WhatsApp destination is disabled and no-ops.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# --- NDPR ---
# Data Protection Officer contact, required in the footer (master spec §14).
# Outstanding with Francis; becomes a CMS setting in Phase 2.
DPO_EMAIL=

# --- Analytics (Umami, self-hosted) ---
# NEXT_PUBLIC_ prefix is required: these render the client-side script tag.
# Master spec §14 lists them without the prefix, which cannot work — see
# docs/decisions.md.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Number behind the wa.me deep links in the header and contact page.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Emergency line shown by app/error.tsx. That boundary is a client component
# and cannot read the database — which is the whole point, since a failed
# database read is one reason it renders. Keep this equal to the primary
# branch's emergency_line in seed/locations.json.
NEXT_PUBLIC_EMERGENCY_LINE=
