# Paelon Memorial Hospital — environment variables
# Copy to .env.local and fill in. Never commit .env.local. Never log these values.

# --- Database (Neon) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth (Phase 2) ---
AUTH_SECRET=
AUTH_URL=

# --- Uploads (UploadThing) ---
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# --- Email (Resend, optional) ---
# The site must work end-to-end with RESEND_ENABLED=false.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Booking notification inboxes, per branch ---
BRANCH_VI_EMAIL=
BRANCH_IKEJA_EMAIL=
BRANCH_MOSHOOD_EMAIL=
BRANCH_DELTA_EMAIL=

# --- WhatsApp Business (provider TBD) ---
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# --- Analytics (Umami, self-hosted) ---
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
